<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Localization</AssemblyName>
    <RootNamespace>Combolands.Localization</RootNamespace>
    <Version>0.3.0</Version>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <CombolandsManagedDir Condition="'$(CombolandsManagedDir)' == ''">$(COMBOLANDS_MANAGED_DIR)</CombolandsManagedDir>
    <UseGameAssemblies Condition="'$(UseGameAssemblies)' == '' and '$(CombolandsManagedDir)' != ''">true</UseGameAssemblies>
    <UseGameAssemblies Condition="'$(UseGameAssemblies)' == ''">false</UseGameAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseGameAssemblies)' != 'true'">
    <ProjectReference Include="../../reference-stubs/Assembly-CSharp/Assembly-CSharp.csproj" Private="false" />
    <ProjectReference Include="../../reference-stubs/Unity.TextMeshPro/Unity.TextMeshPro.csproj" Private="false" />
    <ProjectReference Include="../../reference-stubs/UnityEngine/UnityEngine.csproj" Private="false" />
    <ProjectReference Include="../../reference-stubs/UnityEngine.CoreModule/UnityEngine.CoreModule.csproj" Private="false" />
    <ProjectReference Include="../../reference-stubs/UnityEngine.TextCoreFontEngineModule/UnityEngine.TextCoreFontEngineModule.csproj" Private="false" />
    <ProjectReference Include="../../reference-stubs/UnityEngine.UI/UnityEngine.UI.csproj" Private="false" />
    <ProjectReference Include="../../reference-stubs/UnityEngine.UIModule/UnityEngine.UIModule.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseGameAssemblies)' == 'true'">
    <Reference Include="Assembly-CSharp" HintPath="$(CombolandsManagedDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(CombolandsManagedDir)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(CombolandsManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(CombolandsManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(CombolandsManagedDir)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextCoreFontEngineModule" HintPath="$(CombolandsManagedDir)/UnityEngine.TextCoreFontEngineModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextCoreTextEngineModule" HintPath="$(CombolandsManagedDir)/UnityEngine.TextCoreTextEngineModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(CombolandsManagedDir)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(CombolandsManagedDir)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="Sirenix.Serialization" HintPath="$(CombolandsManagedDir)/Sirenix.Serialization.dll" Private="false" />
    <Reference Include="Sirenix.Utilities" HintPath="$(CombolandsManagedDir)/Sirenix.Utilities.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../localization/zh-Hant.json" Link="zh-Hant.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseGameAssemblies)' == 'true'">
    <RequiredGameReference Include="$(CombolandsManagedDir)/Assembly-CSharp.dll" />
    <RequiredGameReference Include="$(CombolandsManagedDir)/Unity.TextMeshPro.dll" />
    <RequiredGameReference Include="$(CombolandsManagedDir)/UnityEngine.dll" />
    <RequiredGameReference Include="$(CombolandsManagedDir)/UnityEngine.CoreModule.dll" />
    <RequiredGameReference Include="$(CombolandsManagedDir)/UnityEngine.TextRenderingModule.dll" />
    <RequiredGameReference Include="$(CombolandsManagedDir)/UnityEngine.TextCoreFontEngineModule.dll" />
    <RequiredGameReference Include="$(CombolandsManagedDir)/UnityEngine.TextCoreTextEngineModule.dll" />
    <RequiredGameReference Include="$(CombolandsManagedDir)/UnityEngine.UI.dll" />
    <RequiredGameReference Include="$(CombolandsManagedDir)/UnityEngine.UIModule.dll" />
    <RequiredGameReference Include="$(CombolandsManagedDir)/Sirenix.Serialization.dll" />
    <RequiredGameReference Include="$(CombolandsManagedDir)/Sirenix.Utilities.dll" />
  </ItemGroup>

  <Target Name="ValidateCombolandsManagedDir"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(UseGameAssemblies)' == 'true'">
    <Error Condition="'$(CombolandsManagedDir)' == ''"
           Text="CombolandsManagedDir is required when UseGameAssemblies=true." />
    <Error Condition="!Exists('%(RequiredGameReference.Identity)')"
           Text="Missing compile reference: %(RequiredGameReference.Identity)" />
  </Target>
</Project>
